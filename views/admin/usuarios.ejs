<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Usuarios</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#0f172a;color:#e2e8f0;min-height:100vh}
nav{background:#1e293b;padding:.75rem 2rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #334155}
nav .brand{color:white;font-weight:700;font-size:1.1rem;letter-spacing:-.02em}
nav .brand span{color:#3b82f6}
nav .links a{color:#94a3b8;text-decoration:none;padding:.4rem .75rem;border-radius:6px;font-size:.85rem;transition:all .15s}
nav .links a:hover{color:white;background:#334155}
.container{padding:1.5rem 2rem;max-width:1000px;margin:0 auto}
h1{font-size:1.4rem;font-weight:700;color:white;margin-bottom:1.5rem}
.grid{display:grid;grid-template-columns:1fr 340px;gap:1.5rem}
.card{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:1.5rem}
.card-title{font-size:.8rem;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1.25rem}
label{font-size:.8rem;color:#64748b;display:block;margin-bottom:4px;margin-top:.75rem}
input,select{background:#0f172a;border:1px solid #334155;color:#e2e8f0;padding:.5rem .75rem;
  border-radius:8px;font-size:.88rem;font-family:inherit;width:100%}
input::placeholder{color:#475569}
select option{background:#1e293b}
.btn{width:100%;margin-top:1rem;padding:.6rem;background:#3b82f6;color:white;
  border:none;border-radius:8px;cursor:pointer;font-size:.88rem;font-weight:500}
.btn:hover{background:#2563eb}
table{width:100%;border-collapse:collapse}
th{font-size:.73rem;color:#64748b;text-transform:uppercase;letter-spacing:.05em;
   padding:.6rem 0;text-align:left;border-bottom:1px solid #334155}
td{padding:.75rem 0;font-size:.88rem;color:#cbd5e1;border-bottom:1px solid #1e293b;vertical-align:middle}
.badge{display:inline-flex;padding:2px 10px;border-radius:20px;font-size:.75rem;font-weight:500}
.badge.admin{background:#2e1065;color:#a78bfa}
.badge.tecnico{background:#1e3a5f;color:#60a5fa}
.btn-sm{padding:3px 12px;background:#3b0000;color:#f87171;border:none;border-radius:6px;cursor:pointer;font-size:.78rem}
.btn-sm:hover{background:#7f1d1d}
.avatar{width:32px;height:32px;border-radius:50%;background:#1e3a5f;display:inline-flex;
  align-items:center;justify-content:center;font-size:.75rem;font-weight:600;color:#60a5fa;margin-right:.5rem}
@media(max-width:768px){.grid{grid-template-columns:1fr}}
</style>
</head>
<body>
<nav>
  <span class="brand">Ticket<span>Flow</span></span>
  <div class="links">
    <a href="/admin/dashboard">Dashboard</a>
    <a href="/admin/areas">Áreas</a>
    <a href="/admin/usuarios">Usuarios</a>
    <a href="/reportes">Reportes</a>
    <a href="/mantenimiento">Mantenimiento</a>
    <a href="/auth/logout">Cerrar sesión</a>
  </div>
</nav>

<div class="container">
  <h1>Gestión de usuarios</h1>
  <div class="grid">
    <div class="card">
      <div class="card-title">Usuarios del sistema</div>
      <table>
        <thead><tr><th>Usuario</th><th>Rol</th><th>Área</th><th></th></tr></thead>
        <tbody>
        <% usuarios.forEach(u => { %>
        <tr>
          <td>
            <div style="display:flex;align-items:center">
              <span class="avatar"><%= (u.nombre || u.username).charAt(0).toUpperCase() %></span>
              <div>
                <div style="color:white;font-weight:500"><%= u.username %></div>
                <div style="font-size:.75rem;color:#64748b"><%= u.email || '—' %></div>
              </div>
            </div>
          </td>
          <td><span class="badge <%= u.rol %>"><%= u.rol %></span></td>
          <td style="color:#64748b"><%= u.area_nombre || '—' %></td>
          <td>
            <a href="/admin/usuarios/<%= u.id %>/editar" 
             style="padding:3px 12px;background:#1e3a5f;color:#60a5fa;border-radius:6px;font-size:.78rem;text-decoration:none;margin-right:4px">Editar</a>
          <% if (u.username !== 'admin') { %>
            <form method="POST" action="/admin/usuarios/<%= u.id %>/eliminar" style="display:inline">
              <button class="btn-sm" onclick="return confirm('¿Desactivar usuario?')">Desactivar</button>
            </form>
          <% } %>
          </td>
        </tr>
        <% }) %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="card-title">Nuevo usuario</div>
      <form method="POST" action="/admin/usuarios/crear">
        <label>Usuario *</label>
        <input type="text" name="username" required placeholder="nombre_usuario">
        <label>Nombre completo</label>
        <input type="text" name="nombre" placeholder="Nombre Apellido">
        <label>Email</label>
        <input type="email" name="email" placeholder="email@empresa.com">
        <label>Contraseña *</label>
        <input type="password" name="password" required>
        <label>Rol *</label>
        <select name="rol">
          <option value="tecnico">Técnico</option>
          <option value="admin">Admin</option>
        </select>
        <label>Área</label>
        <select name="area_id">
          <option value="">Sin área</option>
          <% areas.forEach(a => { %>
            <option value="<%= a.id %>"><%= a.nombre %></option>
          <% }) %>
        </select>
        <button class="btn" type="submit">Crear usuario</button>
      </form>
    </div>
  </div>
</div>
</body>
</html>