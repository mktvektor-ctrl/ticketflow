<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Panel Admin</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#0f172a;color:#e2e8f0;min-height:100vh}
nav{background:#1e293b;padding:.75rem 2rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #334155}
nav .brand{color:white;font-weight:700;font-size:1.1rem;letter-spacing:-.02em}
nav .brand span{color:#3b82f6}
nav .links{display:flex;align-items:center;gap:.25rem}
nav .links a{color:#94a3b8;text-decoration:none;padding:.4rem .75rem;border-radius:6px;font-size:.85rem;transition:all .15s}
nav .links a:hover{color:white;background:#334155}
nav .links a.active{color:white;background:#3b82f6}
.container{padding:1.5rem 2rem;max-width:1400px;margin:0 auto}
.page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem}
.page-title{font-size:1.4rem;font-weight:700;color:white}
.page-title span{color:#94a3b8;font-size:.9rem;font-weight:400;margin-left:.5rem}
.btn-group{display:flex;gap:.5rem}
.btn{padding:.5rem 1rem;border:none;border-radius:8px;cursor:pointer;font-size:.85rem;font-weight:500;text-decoration:none;display:inline-flex;align-items:center;gap:.4rem;transition:all .15s}
.btn-green{background:#059669;color:white}.btn-green:hover{background:#047857}
.btn-red{background:#dc2626;color:white}.btn-red:hover{background:#b91c1c}
.btn-ghost{background:#1e293b;color:#94a3b8;border:1px solid #334155}.btn-ghost:hover{color:white;border-color:#475569}

.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:1rem;margin-bottom:1.5rem}
.kpi{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:1.25rem;position:relative;overflow:hidden;transition:transform .2s}
.kpi:hover{transform:translateY(-2px)}
.kpi .kpi-label{font-size:.75rem;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem}
.kpi .kpi-val{font-size:2rem;font-weight:700;color:white;line-height:1}
.kpi .kpi-sub{font-size:.75rem;color:#64748b;margin-top:.4rem}
.kpi .kpi-accent{position:absolute;top:0;left:0;width:3px;height:100%;border-radius:12px 0 0 12px}
.kpi.blue .kpi-accent{background:#3b82f6}
.kpi.green .kpi-accent{background:#10b981}
.kpi.red .kpi-accent{background:#ef4444}
.kpi.amber .kpi-accent{background:#f59e0b}
.kpi.purple .kpi-accent{background:#8b5cf6}
.kpi.cyan .kpi-accent{background:#06b6d4}
.kpi.blue .kpi-val{color:#60a5fa}
.kpi.green .kpi-val{color:#34d399}
.kpi.red .kpi-val{color:#f87171}
.kpi.amber .kpi-val{color:#fbbf24}
.kpi.purple .kpi-val{color:#a78bfa}
.kpi.cyan .kpi-val{color:#22d3ee}

.charts-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:1rem;margin-bottom:1.5rem}
@media(max-width:1024px){.charts-grid{grid-template-columns:1fr 1fr}}
@media(max-width:1024px){
  .charts-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:768px){
  table{display:block;overflow-x:auto;white-space:nowrap}
  .charts-grid{grid-template-columns:1fr}
  .kpi-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:640px){
  .charts-grid{grid-template-columns:1fr}
  .kpi-grid{grid-template-columns:1fr 1fr}
  .container{padding:1rem}
  nav{padding:.75rem 1rem}
  nav .brand{font-size:.95rem}
  nav .links{display:flex;flex-wrap:wrap;gap:.25rem;justify-content:flex-end}
  nav .links a{padding:.3rem .4rem;font-size:.75rem}
  .page-header{flex-direction:column;align-items:flex-start;gap:.75rem}
  .btn-group{width:100%;justify-content:flex-end}
  .filter-bar{flex-direction:column}
  .filter-group{min-width:100%}
  th,td{padding:.5rem .75rem;font-size:.78rem}
}
@media(max-width:420px){
  nav .links a{display:none}
  nav .links a:last-child{display:inline-flex}
}
.chart-card{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:1.25rem}
.chart-title{font-size:.85rem;font-weight:600;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1rem}
.chart-wrap{position:relative;height:200px}

.filter-bar{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:1rem;margin-bottom:1rem;display:flex;gap:.75rem;flex-wrap:wrap;align-items:flex-end}
.filter-group{display:flex;flex-direction:column;gap:4px;flex:1;min-width:140px}
.filter-group label{font-size:.73rem;color:#64748b;text-transform:uppercase;letter-spacing:.05em}
.filter-group input,.filter-group select{background:#0f172a;border:1px solid #334155;color:#e2e8f0;padding:.45rem .75rem;border-radius:8px;font-size:.85rem}
.filter-group input::placeholder{color:#475569}
.filter-group select option{background:#1e293b}

.table-card{background:#1e293b;border:1px solid #334155;border-radius:12px;overflow:hidden}
.table-header{padding:1rem 1.25rem;border-bottom:1px solid #334155;display:flex;justify-content:space-between;align-items:center}
.table-header h3{font-size:.9rem;font-weight:600;color:white}
.table-header span{font-size:.8rem;color:#64748b}
table{width:100%;border-collapse:collapse}
th{padding:.75rem 1.25rem;text-align:left;font-size:.73rem;color:#64748b;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #334155}
td{padding:.75rem 1.25rem;font-size:.85rem;color:#cbd5e1;border-bottom:1px solid #1e293b}
tr:last-child td{border-bottom:none}
tr:hover td{background:#263548}
a{color:#60a5fa;text-decoration:none}
a:hover{color:#93c5fd}

.badge{display:inline-flex;align-items:center;padding:2px 10px;border-radius:20px;font-size:.73rem;font-weight:500}
.badge.Nueva{background:#1e3a5f;color:#60a5fa}
.badge.Asignada{background:#3b2a00;color:#fbbf24}
.badge.En-proceso{background:#3b1a00;color:#fb923c}
.badge.Resuelta{background:#064e2a;color:#34d399}
.badge.Cerrada{background:#1e293b;color:#64748b;border:1px solid #334155}
.badge.Baja{background:#064e2a;color:#34d399}
.badge.Media{background:#3b2a00;color:#fbbf24}
.badge.Alta{background:#3b1a00;color:#fb923c}
.badge.Critica{background:#3b0000;color:#f87171}

.horas{font-size:.8rem;color:#64748b}
.horas.urgente{color:#f87171;font-weight:600}

.alert-bar{background:#3b0000;border:1px solid #7f1d1d;border-radius:10px;padding:.75rem 1.25rem;
           margin-bottom:1rem;display:flex;align-items:center;gap:.75rem;font-size:.85rem;color:#fca5a5}
</style>
</head>
<body>
<nav>
  <span class="brand">Ticket<span>Flow</span></span>
  <div class="links">
    <a href="/admin/dashboard" class="active">Dashboard</a>
    <a href="/admin/areas">Áreas</a>
    <a href="/admin/usuarios">Usuarios</a>
    <a href="/reportes">Reportes</a>
    <a href="/mantenimiento">Mantenimiento</a>
    <a href="/auth/logout">Cerrar sesión</a>
  </div>
</nav>

<div class="container">
  <div class="page-header">
    <div>
      <div class="page-title">Panel de control <span>Bienvenido, <%= currentUser %></span></div>
    </div>
    <div class="btn-group">
      <button onclick="document.getElementById('modal-exportar').style.display='flex'" class="btn btn-green">↓ Excel</button>
      <button onclick="document.getElementById('modal-exportar').style.display='flex'" class="btn btn-red">↓ PDF</button>
    </div>
  </div>

  <% if (vencidos.total > 0) { %>
  <div class="alert-bar">
    ⚠️ <strong><%= vencidos.total %> tickets</strong> llevan más de 3 días sin resolver
  </div>
  <% } %>

  <div class="kpi-grid">
    <div class="kpi blue"><div class="kpi-accent"></div>
      <div class="kpi-label">Total tickets</div>
      <div class="kpi-val"><%= stats.total %></div>
      <div class="kpi-sub"><%= stats.creados_hoy %> hoy · <%= stats.creados_semana %> esta semana</div>
    </div>
    <div class="kpi red"><div class="kpi-accent"></div>
      <div class="kpi-label">Nuevas</div>
      <div class="kpi-val"><%= stats.nuevas %></div>
      <div class="kpi-sub">Sin asignar</div>
    </div>
    <div class="kpi amber"><div class="kpi-accent"></div>
      <div class="kpi-label">En proceso</div>
      <div class="kpi-val"><%= stats.en_proceso %></div>
      <div class="kpi-sub"><%= stats.asignadas %> asignadas</div>
    </div>
    <div class="kpi green"><div class="kpi-accent"></div>
      <div class="kpi-label">Resueltas</div>
      <div class="kpi-val"><%= stats.resueltas %></div>
      <div class="kpi-sub"><%= stats.cerradas %> cerradas</div>
    </div>
    <div class="kpi purple"><div class="kpi-accent"></div>
      <div class="kpi-label">Tasa resolución</div>
      <div class="kpi-val"><%= stats.tasa_resolucion || 0 %>%</div>
      <div class="kpi-sub">Del total de tickets</div>
    </div>
    <div class="kpi cyan"><div class="kpi-accent"></div>
      <div class="kpi-label">Tiempo promedio</div>
      <div class="kpi-val"><%= stats.promedio_horas || 0 %>h</div>
      <div class="kpi-sub">De resolución</div>
    </div>
    <div class="kpi red"><div class="kpi-accent"></div>
      <div class="kpi-label">Críticos pendientes</div>
      <div class="kpi-val"><%= stats.criticas_pendientes %></div>
      <div class="kpi-sub">Requieren atención</div>
    </div>
    <div class="kpi amber"><div class="kpi-accent"></div>
      <div class="kpi-label">Este mes</div>
      <div class="kpi-val"><%= stats.creados_mes %></div>
      <div class="kpi-sub">Tickets creados</div>
    </div>
  </div>

  <div class="charts-grid">
    <div class="chart-card">
      <div class="chart-title">Tickets últimos 14 días</div>
      <div class="chart-wrap"><canvas id="chartDias"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Por estado</div>
      <div class="chart-wrap"><canvas id="chartEstado"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Por prioridad</div>
      <div class="chart-wrap"><canvas id="chartPrioridad"></canvas></div>
    </div>
  </div>

  <form method="GET" action="/admin/dashboard" class="filter-bar">
    <div class="filter-group" style="flex:2">
      <label>Buscar</label>
      <input type="text" name="busqueda" placeholder="Código, título o cliente..." value="<%= filtros.busqueda || '' %>">
    </div>
    <div class="filter-group">
      <label>Estado</label>
      <select name="estado">
        <option value="">Todos</option>
        <% ['Nueva','Asignada','En proceso','Resuelta','Cerrada'].forEach(e => { %>
          <option value="<%= e %>" <%= filtros.estado === e ? 'selected' : '' %>><%= e %></option>
        <% }) %>
      </select>
    </div>
    <div class="filter-group">
      <label>Prioridad</label>
      <select name="prioridad">
        <option value="">Todas</option>
        <% ['Baja','Media','Alta','Critica'].forEach(p => { %>
          <option value="<%= p %>" <%= filtros.prioridad === p ? 'selected' : '' %>><%= p %></option>
        <% }) %>
      </select>
    </div>
    <div class="filter-group">
      <label>Área</label>
      <select name="area">
        <option value="">Todas</option>
        <% areas.forEach(a => { %>
          <option value="<%= a.id %>" <%= filtros.area == a.id ? 'selected' : '' %>><%= a.nombre %></option>
        <% }) %>
      </select>
    </div>
    <div style="display:flex;gap:.5rem">
      <button type="submit" class="btn btn-ghost" style="color:white">Filtrar</button>
      <a href="/admin/dashboard" class="btn btn-ghost">Limpiar</a>
    </div>
  </form>

  <div class="table-card">
    <div class="table-header">
      <h3>Tickets activos</h3>
      <span><%= tickets.length %> resultados</span>
    </div>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Título</th>
          <th>Cliente</th>
          <th>Prioridad</th>
          <th>Estado</th>
          <th>Área</th>
          <th>Tiempo</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% if (tickets.length === 0) { %>
        <tr><td colspan="8" style="text-align:center;color:#475569;padding:2rem">No hay tickets</td></tr>
      <% } %>
      <% tickets.forEach(t => { %>
      <tr>
        <td style="color:#60a5fa;font-weight:500"><%= t.codigo %></td>
        <td><%= t.titulo.substring(0,40) %><%= t.titulo.length>40?'…':'' %></td>
        <td><%= t.nombre_cliente %></td>
        <td><span class="badge <%= t.prioridad %>"><%= t.prioridad %></span></td>
        <td><span class="badge <%= t.estado.replace(' ','-') %>"><%= t.estado %></span></td>
        <td><%= t.area_nombre || '—' %></td>
        <td class="horas <%= t.horas_abierto > 48 ? 'urgente' : '' %>"><%= t.horas_abierto %>h</td>
        <td><a href="/admin/ticket/<%= t.id %>">Ver →</a></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div id="modal-exportar" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;
     background:rgba(0,0,0,.7);z-index:1000;align-items:center;justify-content:center">
  <div style="background:#1e293b;border:1px solid #334155;border-radius:16px;padding:2rem;width:500px;max-width:95vw">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.5rem">
      <h2 style="font-size:1.1rem;color:white;margin:0">Opciones de exportación</h2>
      <button onclick="document.getElementById('modal-exportar').style.display='none'"
        style="background:none;border:none;font-size:1.2rem;cursor:pointer;color:#64748b">✕</button>
    </div>
   <form id="form-exportar">
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem">
        <div>
          <label style="font-size:.75rem;color:#64748b;display:block;margin-bottom:4px;text-transform:uppercase">Estado</label>
          <select name="estado" style="width:100%;padding:.5rem;background:#0f172a;border:1px solid #334155;color:#e2e8f0;border-radius:8px;font-size:.88rem">
            <option value="">Todos</option>
            <option value="cerrados">Cerrados y Resueltos</option>
            <% ['Nueva','Asignada','En proceso','Resuelta','Cerrada'].forEach(e => { %>
              <option value="<%= e %>"><%= e %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label style="font-size:.75rem;color:#64748b;display:block;margin-bottom:4px;text-transform:uppercase">Prioridad</label>
          <select name="prioridad" style="width:100%;padding:.5rem;background:#0f172a;border:1px solid #334155;color:#e2e8f0;border-radius:8px;font-size:.88rem">
            <option value="">Todas</option>
            <% ['Baja','Media','Alta','Critica'].forEach(p => { %>
              <option value="<%= p %>"><%= p %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label style="font-size:.75rem;color:#64748b;display:block;margin-bottom:4px;text-transform:uppercase">Área</label>
          <select name="area" style="width:100%;padding:.5rem;background:#0f172a;border:1px solid #334155;color:#e2e8f0;border-radius:8px;font-size:.88rem">
            <option value="">Todas</option>
            <% areas.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.nombre %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label style="font-size:.75rem;color:#64748b;display:block;margin-bottom:4px;text-transform:uppercase">Abiertos más de (días)</label>
          <input type="number" name="dias_abierto" min="1" placeholder="Ej: 7"
            style="width:100%;padding:.5rem;background:#0f172a;border:1px solid #334155;color:#e2e8f0;border-radius:8px;font-size:.88rem">
        </div>
        <div>
          <label style="font-size:.75rem;color:#64748b;display:block;margin-bottom:4px;text-transform:uppercase">Fecha desde</label>
          <input type="date" name="fecha_desde"
            style="width:100%;padding:.5rem;background:#0f172a;border:1px solid #334155;color:#e2e8f0;border-radius:8px;font-size:.88rem">
        </div>
        <div>
          <label style="font-size:.75rem;color:#64748b;display:block;margin-bottom:4px;text-transform:uppercase">Fecha hasta</label>
          <input type="date" name="fecha_hasta"
            style="width:100%;padding:.5rem;background:#0f172a;border:1px solid #334155;color:#e2e8f0;border-radius:8px;font-size:.88rem">
        </div>
      </div>
      <div style="display:flex;gap:.75rem;margin-top:1rem">
        <button type="button" onclick="exportar('excel')" class="btn btn-green" style="flex:1;justify-content:center">↓ Excel</button>
        <button type="button" onclick="exportar('pdf')" class="btn btn-red" style="flex:1;justify-content:center">↓ PDF</button>
      </div>
    </form>
  </div>
</div>

<script>
const diasLabels = <%- JSON.stringify(porDia.map(d => new Date(d.dia).toLocaleDateString('es-ES', {day:'2-digit',month:'2-digit'}))) %>;
const diasData   = <%- JSON.stringify(porDia.map(d => d.total)) %>;
const estadoLabels = <%- JSON.stringify(porEstado.map(e => e.estado)) %>;
const estadoData   = <%- JSON.stringify(porEstado.map(e => e.total)) %>;
const prioLabels = <%- JSON.stringify(porPrioridad.map(p => p.prioridad)) %>;
const prioData   = <%- JSON.stringify(porPrioridad.map(p => p.total)) %>;

const chartOpts = { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:false } } };

new Chart(document.getElementById('chartDias'), {
  type: 'line',
  data: {
    labels: diasLabels,
    datasets: [{ data: diasData, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,.1)',
      fill: true, tension: .4, pointBackgroundColor: '#3b82f6', pointRadius: 4 }]
  },
  options: { ...chartOpts, scales: {
    x: { ticks: { color: '#64748b', font: { size: 11 } }, grid: { color: '#1e293b' } },
    y: { ticks: { color: '#64748b', font: { size: 11 } }, grid: { color: '#334155' } }
  }}
});

new Chart(document.getElementById('chartEstado'), {
  type: 'doughnut',
  data: {
    labels: estadoLabels,
    datasets: [{ data: estadoData,
      backgroundColor: ['#3b82f6','#f59e0b','#fb923c','#10b981','#64748b'],
      borderColor: '#1e293b', borderWidth: 2 }]
  },
  options: { ...chartOpts, plugins: { legend: { display: true, position: 'bottom',
    labels: { color: '#94a3b8', font: { size: 11 }, padding: 8 } } } }
});

new Chart(document.getElementById('chartPrioridad'), {
  type: 'doughnut',
  data: {
    labels: prioLabels,
    datasets: [{ data: prioData,
      backgroundColor: ['#10b981','#f59e0b','#fb923c','#ef4444'],
      borderColor: '#1e293b', borderWidth: 2 }]
  },
  options: { ...chartOpts, plugins: { legend: { display: true, position: 'bottom',
    labels: { color: '#94a3b8', font: { size: 11 }, padding: 8 } } } }
});

function exportar(formato) {
    const form = document.getElementById('form-exportar');
    const data = new FormData(form);
    const params = new URLSearchParams();
    for (const [key, value] of data.entries()) {
        if (value) params.append(key, value);
    }
    window.location.href = `/exportar/${formato}?${params.toString()}`;
}
</script>
</body>
</html>