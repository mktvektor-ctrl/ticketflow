<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Dashboard</title>
<style>
body{font-family:system-ui,sans-serif;background:#f8fafc;margin:0;padding:1.5rem}
h1{margin-bottom:1.5rem;font-size:1.4rem}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:1rem;margin-bottom:2rem}
.kpi{background:white;border-radius:12px;padding:1.25rem;box-shadow:0 1px 4px rgba(0,0,0,.07);text-align:center}
.kpi .num{font-size:2rem;font-weight:700;color:#1a56db}
.kpi .label{font-size:.8rem;color:#64748b;margin-top:4px}
table{width:100%;background:white;border-radius:12px;border-collapse:collapse;
      overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,.07)}
th{background:#f1f5f9;padding:.75rem 1rem;text-align:left;font-size:.8rem;
   color:#64748b;text-transform:uppercase}
td{padding:.75rem 1rem;font-size:.9rem;border-top:1px solid #f1f5f9}
a{color:#1a56db;text-decoration:none}
</style>
</head>
<body>
<a href="/reclamaciones/kanban">← Volver al Kanban</a>
<h1>Dashboard</h1>

<div class="grid">
  <div class="kpi"><div class="num"><%= stats.total %></div><div class="label">Total</div></div>
  <div class="kpi"><div class="num"><%= stats.abiertas %></div><div class="label">Nuevas</div></div>
  <div class="kpi"><div class="num"><%= stats.proceso %></div><div class="label">En proceso</div></div>
  <div class="kpi"><div class="num"><%= stats.resueltas %></div><div class="label">Resueltas</div></div>
  <div class="kpi"><div class="num"><%= stats.cerradas %></div><div class="label">Cerradas</div></div>
  <div class="kpi"><div class="num" style="color:#b91c1c"><%= stats.criticas %></div><div class="label">Criticas</div></div>
</div>

<table>
  <thead><tr><th>Código</th><th>Título</th><th>Estado</th><th>Fecha</th></tr></thead>
  <tbody>
  <% recientes.forEach(r => { %>
  <tr>
    <td><a href="/reclamaciones/<%= r.id %>"><%= r.codigo %></a></td>
    <td><%= r.titulo %></td>
    <td><%= r.estado %></td>
    <td><%= new Date(r.fecha).toLocaleDateString('es-ES') %></td>
  </tr>
  <% }) %>
  </tbody>
</table>
</body>
</html>