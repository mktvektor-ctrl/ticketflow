<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sistema de Reclamaciones</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#0f172a;color:#e2e8f0;min-height:100vh;
     display:flex;flex-direction:column;align-items:center;justify-content:center;padding:2rem}
.logo{font-size:1.5rem;font-weight:700;color:white;letter-spacing:-.02em;margin-bottom:.5rem}
.logo span{color:#3b82f6}
.tagline{color:#64748b;font-size:.9rem;margin-bottom:3rem;text-align:center}
.cards{display:flex;gap:1.25rem;justify-content:center;flex-wrap:wrap;max-width:700px}
.card{background:#1e293b;border:1px solid #334155;border-radius:16px;padding:1.75rem;
      width:200px;cursor:pointer;text-decoration:none;color:inherit;
      transition:all .2s;display:flex;flex-direction:column;align-items:center;text-align:center}
.card:hover{transform:translateY(-4px);border-color:#475569}
.card.blue:hover{border-color:#3b82f6}
.card.green:hover{border-color:#10b981}
.card.purple:hover{border-color:#8b5cf6}
.card .icon{width:48px;height:48px;border-radius:12px;display:flex;align-items:center;
            justify-content:center;font-size:1.4rem;margin-bottom:1rem}
.card.blue .icon{background:#1e3a5f}
.card.green .icon{background:#064e2a}
.card.purple .icon{background:#2e1065}
.card h2{font-size:.95rem;font-weight:600;color:white;margin-bottom:.4rem}
.card p{font-size:.8rem;color:#64748b;line-height:1.5}
.card .arrow{margin-top:1rem;color:#475569;font-size:.85rem;transition:color .2s}
.card:hover .arrow{color:#94a3b8}
footer{margin-top:3rem;color:#334155;font-size:.78rem}
</style>
</head>
<body>
<div class="logo">Ticket<span>Flow</span></div>
<p class="tagline">Sistema de gestión de reclamaciones</p>

<div class="cards">
  <a href="/nueva-reclamacion" class="card blue">
    <div class="icon">📝</div>
    <h2>Presentar reclamación</h2>
    <p>Registra una nueva queja o reclamación</p>
    <div class="arrow">Continuar →</div>
  </a>
  <a href="/consultar" class="card green">
    <div class="icon">🔍</div>
    <h2>Ver estado</h2>
    <p>Consulta con tu código de seguimiento</p>
    <div class="arrow">Continuar →</div>
  </a>
  <a href="/auth/login" class="card purple">
    <div class="icon">🔐</div>
    <h2>Acceso empleados</h2>
    <p>Área privada para gestión interna</p>
    <div class="arrow">Continuar →</div>
  </a>
</div>

<footer>
  Desarrollado por <a href="https://www.vektormkt.es" target="_blank" 
  style="color:#475569;text-decoration:none">VektorMKT</a> · 
  <a href="https://www.vektormkt.es" target="_blank" 
  style="color:#475569;text-decoration:none">www.vektormkt.es</a>
</footer>
</body>
</html>