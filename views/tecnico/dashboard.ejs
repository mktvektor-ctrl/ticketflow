<nav>
  <span class="brand">Ticket<span>Flow</span></span>
  <div class="right">
    <span class="area-tag"><%= areaNombre || 'Sin área' %></span>
    <div class="links">
      <a href="/auth/logout">Cerrar sesión</a>
    </div>
  </div>
</nav>

<div class="container">
  <h1>Mis tickets</h1>
  <p class="subtitle">Tickets asignados a tu área · <%= currentUser %></p>

  <div class="kpi-grid">
    <div class="kpi red"><div class="kpi-accent"></div>
      <div class="kpi-label">Pendientes</div>
      <div class="kpi-val"><%= stats.pendientes || 0 %></div>
    </div>
    <div class="kpi blue"><div class="kpi-accent"></div>
      <div class="kpi-label">En proceso</div>
      <div class="kpi-val"><%= stats.en_proceso || 0 %></div>
    </div>
    <div class="kpi green"><div class="kpi-accent"></div>
      <div class="kpi-label">Resueltos</div>
      <div class="kpi-val"><%= stats.resueltos || 0 %></div>
    </div>
  </div>

  <div class="section-title">Tickets pendientes</div>
  <div class="table-card">
    <div class="table-header">
      <h3>Pendientes</h3>
      <span><%= pendientes.length %> tickets</span>
    </div>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Título</th>
          <th>Cliente</th>
          <th>Prioridad</th>
          <th>Estado</th>
          <th>Tiempo abierto</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
      <% if (pendientes.length === 0) { %>
        <tr><td colspan="7" style="text-align:center;color:#475569;padding:2rem">No tienes tickets pendientes</td></tr>
      <% } %>
      <% pendientes.forEach(t => { %>
      <tr>
        <td style="color:#60a5fa;font-weight:500"><%= t.codigo %></td>
        <td><%= t.titulo.substring(0,35) %><%= t.titulo.length>35?'…':'' %></td>
        <td><%= t.nombre_cliente %></td>
        <td><span class="badge <%= t.prioridad %>"><%= t.prioridad %></span></td>
        <td><span class="badge <%= t.estado.replace(' ','-') %>"><%= t.estado %></span></td>
        <td class="horas <%= t.horas_abierto > 48 ? 'urgente' : '' %>"><%= t.horas_abierto %>h</td>
        <td><a href="/tecnico/ticket/<%= t.id %>">Ver →</a></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>

  <div class="section-title">Tickets gestionados anteriormente</div>
  <div class="table-card">
    <div class="table-header">
      <h3>Historial</h3>
      <span><%= gestionados.length %> tickets</span>
    </div>
    <table>
      <thead>
        <tr>
          <th>Código</th>
          <th>Título</th>
          <th>Estado</th>
          <th>Tiempo total</th>
        </tr>
      </thead>
      <tbody>
      <% if (gestionados.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;color:#475569;padding:2rem">Sin tickets gestionados aún</td></tr>
      <% } %>
      <% gestionados.forEach(t => { %>
      <tr>
        <td style="color:#60a5fa;font-weight:500"><%= t.codigo %></td>
        <td><%= t.titulo.substring(0,40) %><%= t.titulo.length>40?'…':'' %></td>
        <td><span class="badge <%= t.estado.replace(' ','-') %>"><%= t.estado %></span></td>
        <td class="horas"><%= t.horas_total %>h</td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>
</body>
</html>