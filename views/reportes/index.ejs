<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reportes</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:system-ui,sans-serif;background:#0f172a;color:#e2e8f0;min-height:100vh}
nav{background:#1e293b;padding:.75rem 2rem;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #334155}
nav .brand{color:white;font-weight:700;font-size:1.1rem;letter-spacing:-.02em}
nav .brand span{color:#3b82f6}
nav .links a{color:#94a3b8;text-decoration:none;padding:.4rem .75rem;border-radius:6px;font-size:.85rem;transition:all .15s}
nav .links a:hover{color:white;background:#334155}
nav .links a.active{color:white;background:#3b82f6}
.container{padding:1.5rem 2rem;max-width:1200px;margin:0 auto}
h1{font-size:1.4rem;font-weight:700;color:white;margin-bottom:1.5rem}
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin-bottom:1.5rem}
.kpi{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:1.25rem;position:relative;overflow:hidden}
.kpi .kpi-accent{position:absolute;top:0;left:0;width:3px;height:100%}
.kpi.blue .kpi-accent{background:#3b82f6}
.kpi.green .kpi-accent{background:#10b981}
.kpi.amber .kpi-accent{background:#f59e0b}
.kpi.red .kpi-accent{background:#ef4444}
.kpi .kpi-label{font-size:.75rem;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.5rem}
.kpi .kpi-val{font-size:2rem;font-weight:700}
.kpi.blue .kpi-val{color:#60a5fa}
.kpi.green .kpi-val{color:#34d399}
.kpi.amber .kpi-val{color:#fbbf24}
.kpi.red .kpi-val{color:#f87171}
.kpi .kpi-sub{font-size:.75rem;color:#475569;margin-top:.4rem}
.charts-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem}
.chart-card{background:#1e293b;border:1px solid #334155;border-radius:12px;padding:1.5rem}
.chart-title{font-size:.8rem;font-weight:600;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:1rem}
.chart-wrap{position:relative;height:220px}
.table-card{background:#1e293b;border:1px solid #334155;border-radius:12px;overflow:hidden;margin-bottom:1.5rem}
.table-header{padding:1rem 1.25rem;border-bottom:1px solid #334155}
.table-header h3{font-size:.9rem;font-weight:600;color:white}
table{width:100%;border-collapse:collapse}
th{padding:.75rem 1.25rem;text-align:left;font-size:.73rem;color:#64748b;text-transform:uppercase;letter-spacing:.06em;border-bottom:1px solid #334155}
td{padding:.75rem 1.25rem;font-size:.85rem;color:#cbd5e1;border-bottom:1px solid #1e293b}
tr:last-child td{border-bottom:none}
tr:hover td{background:#263548}
a{color:#60a5fa;text-decoration:none}
.badge{display:inline-flex;padding:2px 10px;border-radius:20px;font-size:.73rem;font-weight:500}
.badge.Alta{background:#3b1a00;color:#fb923c}
.badge.Media{background:#3b2a00;color:#fbbf24}
.badge.Baja{background:#064e2a;color:#34d399}
.badge.Crítica{background:#3b0000;color:#f87171}
.horas{font-size:.8rem;color:#64748b}
.horas.urgente{color:#f87171;font-weight:600}
.bar-bg{background:#0f172a;border-radius:4px;height:6px;margin-top:4px}
.bar-fill{background:#3b82f6;border-radius:4px;height:6px}
@media(max-width:768px){.charts-grid{grid-template-columns:1fr}.container{padding:1rem}}
</style>
</head>
<body>
<nav>
  <span class="brand">Ticket<span>Flow</span></span>
  <div class="links">
    <a href="/admin/dashboard">Dashboard</a>
    <a href="/admin/areas">Áreas</a>
    <a href="/admin/usuarios">Usuarios</a>
    <a href="/reportes" class="active">Reportes</a>
    <a href="/auth/logout">Cerrar sesión</a>
  </div>
</nav>

<div class="container">
  <h1>Reportes y supervisión</h1>

  <div class="kpi-grid">
    <div class="kpi blue"><div class="kpi-accent"></div>
      <div class="kpi-label">Tiempo promedio</div>
      <div class="kpi-val"><%= tiempos.promedio_horas > 0 ? tiempos.promedio_horas + 'h' : tiempos.promedio_min + 'min' || '—' %></div>
      <div class="kpi-sub">De resolución</div>
    </div>
    <div class="kpi green"><div class="kpi-accent"></div>
      <div class="kpi-label">Tiempo mínimo</div>
      <div class="kpi-val"><%= tiempos.minimo_horas > 0 ? tiempos.minimo_horas + 'h' : tiempos.minimo_min + 'min' || '—' %></div>
      <div class="kpi-sub">Más rápido resuelto</div>
    </div>
    <div class="kpi red"><div class="kpi-accent"></div>
      <div class="kpi-label">Tiempo máximo</div>
      <div class="kpi-val"><%= tiempos.maximo_horas > 0 ? tiempos.maximo_horas + 'h' : tiempos.maximo_min + 'min' || '—' %></div>
      <div class="kpi-sub">Más lento resuelto</div>
    </div>
    <div class="kpi amber"><div class="kpi-accent"></div>
      <div class="kpi-label">Total cerrados</div>
      <div class="kpi-val"><%= tiempos.total_cerrados || 0 %></div>
      <div class="kpi-sub">Tickets resueltos</div>
    </div>
  </div>

  <div class="charts-grid">
    <div class="chart-card">
      <div class="chart-title">Tickets por estado</div>
      <div class="chart-wrap"><canvas id="chartEstado"></canvas></div>
    </div>
    <div class="chart-card">
      <div class="chart-title">Tickets por prioridad</div>
      <div class="chart-wrap"><canvas id="chartPrioridad"></canvas></div>
    </div>
  </div>

  <div class="charts-grid">
    <div class="table-card">
      <div class="table-header"><h3>Rendimiento por área</h3></div>
      <table>
        <thead><tr><th>Área</th><th>Total</th><th>Pendientes</th><th>Promedio</th><th>Carga</th></tr></thead>
        <tbody>
        <% const maxTotal = Math.max(...porArea.map(a => a.total || 0), 1) %>
        <% porArea.forEach(a => { %>
        <tr>
          <td style="color:white;font-weight:500"><%= a.area %></td>
          <td><%= a.total || 0 %></td>
          <td style="color:<%= (a.pendientes||0) > 0 ? '#f87171' : '#34d399' %>"><%= a.pendientes || 0 %></td>
          <td class="horas"><%= a.promedio_horas || 0 %>h</td>
          <td style="width:100px">
            <div class="bar-bg"><div class="bar-fill" style="width:<%= Math.round(((a.total||0)/maxTotal)*100) %>%"></div></div>
          </td>
        </tr>
        <% }) %>
        </tbody>
      </table>
    </div>

    <div class="table-card">
      <div class="table-header"><h3>Tickets más antiguos sin resolver</h3></div>
      <table>
        <thead><tr><th>Código</th><th>Título</th><th>Área</th><th>Tiempo</th></tr></thead>
        <tbody>
        <% if (masAntiguos.length === 0) { %>
          <tr><td colspan="4" style="text-align:center;color:#475569;padding:2rem">Sin tickets pendientes</td></tr>
        <% } %>
        <% masAntiguos.forEach(t => { %>
        <tr>
          <td><a href="/admin/ticket/<%= t.id %>"><%= t.codigo %></a></td>
          <td><%= t.titulo.substring(0,28) %><%= t.titulo.length>28?'…':'' %></td>
          <td style="color:#64748b"><%= t.area_nombre || '—' %></td>
          <td class="horas <%= t.horas_abierto > 48 ? 'urgente' : '' %>"><%= t.horas_abierto %>h</td>
        </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="table-card">
    <div class="table-header"><h3>Tickets por prioridad — detalle</h3></div>
    <table>
      <thead><tr><th>Prioridad</th><th>Total</th><th>Pendientes</th><th>Promedio resolución</th></tr></thead>
      <tbody>
      <% porPrioridad.forEach(p => { %>
      <tr>
        <td><span class="badge <%= p.prioridad %>"><%= p.prioridad %></span></td>
        <td><%= p.total %></td>
        <td><%= p.pendientes || 0 %></td>
        <td class="horas"><%= p.promedio_horas || 0 %>h</td>
      </tr>
      <% }) %>
      </tbody>
    </table>
  </div>
</div>

<script>
const chartOpts = { responsive:true, maintainAspectRatio:false, plugins:{ legend:{ display:true, position:'bottom', labels:{ color:'#94a3b8', font:{ size:11 }, padding:8 } } } };

new Chart(document.getElementById('chartEstado'), {
  type: 'doughnut',
  data: {
    labels: <%- JSON.stringify(porEstado.map(e => e.estado)) %>,
    datasets: [{ data: <%- JSON.stringify(porEstado.map(e => e.total)) %>,
      backgroundColor: ['#3b82f6','#f59e0b','#fb923c','#10b981','#64748b'],
      borderColor: '#1e293b', borderWidth: 2 }]
  },
  options: chartOpts
});

new Chart(document.getElementById('chartPrioridad'), {
  type: 'bar',
  data: {
    labels: <%- JSON.stringify(porPrioridad.map(p => p.prioridad)) %>,
    datasets: [{
      label: 'Tickets',
      data: <%- JSON.stringify(porPrioridad.map(p => p.total)) %>,
      backgroundColor: ['#10b981','#f59e0b','#fb923c','#ef4444'],
      borderRadius: 6
    }]
  },
  options: { ...chartOpts,
    plugins:{ legend:{ display:false } },
    scales:{
      x:{ ticks:{ color:'#64748b' }, grid:{ color:'#1e293b' } },
      y:{ ticks:{ color:'#64748b' }, grid:{ color:'#334155' } }
    }
  }
});
</script>
</body>
</html>